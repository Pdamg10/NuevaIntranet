<?xml version="1.0" encoding="utf-8"?>
<configuration><system.webServer>
  <security><requestFiltering>
    <fileExtensions><add fileExtension=".csv" allowed="false" /></fileExtensions>
    <hiddenSegments><add segment="storage" /></hiddenSegments>
  </requestFiltering></security>
  <staticContent><remove fileExtension=".json" /><mimeMap fileExtension=".json" mimeType="application/json" /></staticContent>
</system.webServer></configuration>
