# Configuración del entorno local WordPress (:8080) para CVG Alcasa
# Copia este archivo como .env antes de levantar Docker:
#   cp .env.example .env

# Puerto local (alineado con despliegue Ubuntu :8080)
WP_PORT=8080
WP_HOME=http://localhost:8080
WP_SITEURL=http://localhost:8080

# Base de datos MySQL local (en Azure se reemplaza por Azure Database for MySQL Flexible Server)
MYSQL_DATABASE=alcasa_wp
MYSQL_USER=alcasa_user
MYSQL_PASSWORD=AlcasaDev#2026_CambiaEstaClave
MYSQL_ROOT_PASSWORD=AlcasaRoot#2026_CambiaEstaClave

# Cuenta inicial de WordPress para setup-local.sh (solo entorno local)
WP_ADMIN_USER=alcasa_admin
WP_ADMIN_PASSWORD=AlcasaAdmin#2026_Cambia
WP_ADMIN_EMAIL=sistemas@alcasa.com.ve

# Integraciones y media de CVG Alcasa
# En Azure, ALCASA_MEDIA_BASE_URL puede apuntar a Azure Blob Storage / Front Door
ALCASA_MEDIA_BASE_URL=/alcasa-media
ALCASA_DATA_BASE_URL=/alcasa-data
ALCASA_NEWS_URL=http://alcasa.com.ve:5001
