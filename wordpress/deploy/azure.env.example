# Plantilla de configuración para aprovisionamiento y despliegue en Microsoft Azure
# En el equipo Ubuntu de despliegue:
#   cp wordpress/deploy/azure.env.example wordpress/deploy/azure.env
#   nano wordpress/deploy/azure.env
# (azure.env está ignorado por git — nunca subas claves reales al repositorio)

# Identidad y región de Azure
AZURE_SUBSCRIPTION_ID=""
AZURE_LOCATION="eastus2"
AZURE_RESOURCE_GROUP="rg-cvg-alcasa-portal"

# Azure App Service (Linux PHP 8.2)
AZURE_APP_PLAN="asp-cvg-alcasa-linux"
AZURE_APP_SKU="B2"
AZURE_WEBAPP_NAME="cvg-alcasa-portal"
AZURE_STAGING_SLOT="staging"

# Azure Database for MySQL — Flexible Server
AZURE_MYSQL_SERVER="mysql-cvg-alcasa"
AZURE_MYSQL_SKU="Standard_B1ms"
AZURE_MYSQL_VERSION="8.0.21"
AZURE_MYSQL_DB="alcasa_wp"
AZURE_MYSQL_ADMIN_USER="alcasaadmin"
# Déjalo vacío para que azure-provision.sh genere una clave fuerte automáticamente
AZURE_MYSQL_ADMIN_PASSWORD=""

# Azure Blob Storage para los ~174 MB de media (img + videos MP4 + PDFs)
AZURE_STORAGE_ACCOUNT="stcvgalcasamedia"
AZURE_STORAGE_CONTAINER="alcasa-media"

# URLs e integraciones del portal
WP_PUBLIC_URL="https://cvg-alcasa-portal.azurewebsites.net"
ALCASA_NEWS_URL="http://alcasa.com.ve:5001"
ALCASA_MAIL_CONTACTO=""
ALCASA_MAIL_RRHH=""
